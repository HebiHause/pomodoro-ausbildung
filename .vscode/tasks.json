{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Pascal",
      "type": "process",
      "command": "fpc",
      "args": ["${file}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Pascal",
      "type": "process",
      "command": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": "Compile Pascal",
      "problemMatcher": []
    }
  ]
}